// Copy to Config/Secrets.xcconfig (gitignored) and fill in the values from the Supabase dashboard
// (Project Settings → API). The anon key is public by design; row-level security is the boundary.
// `//` starts a comment in xcconfig, so either escape the scheme with $() or leave it out (the app adds https://).
PASS_SUPABASE_URL = https:/$()/your-project-ref.supabase.co
PASS_SUPABASE_ANON_KEY = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace-me
